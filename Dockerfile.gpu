FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

WORKDIR /app

ARG APT_MIRROR=

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    GLMOCR_SERVER_HOST=0.0.0.0 \
    GLMOCR_SERVER_PORT=5002 \
    GLMOCR_ENABLE_LAYOUT=true \
    GLMOCR_LAYOUT_DEVICE=cuda:0

RUN set -eux; \
    if [ -n "${APT_MIRROR}" ] && [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i "s|archive.ubuntu.com|${APT_MIRROR}|g; s|security.ubuntu.com|${APT_MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY glmocr ./glmocr
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh && \
    pip install --no-cache-dir uv && \
    uv pip install --system -e . && \
    uv pip install --system \
      "flask>=3.1.0" \
      "transformers>=4.46.0" \
      "sentencepiece>=0.2.0" \
      "accelerate>=1.0.0"

EXPOSE 5002

ENTRYPOINT ["/entrypoint.sh"]
