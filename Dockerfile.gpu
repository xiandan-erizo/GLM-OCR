FROM ekb-repo.tencentcloudcr.com/library/glm-ocr-parse:hose-dev-20260330194524-daa93e7d

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    GLMOCR_SERVER_HOST=0.0.0.0 \
    GLMOCR_SERVER_PORT=5002 \
    GLMOCR_ENABLE_LAYOUT=true \
    GLMOCR_LAYOUT_DEVICE=cuda:0

COPY pyproject.toml README.md ./
COPY glmocr ./glmocr
COPY docker/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh && \
    python -m pip install --no-cache-dir --break-system-packages -e ".[server,layout]"

EXPOSE 5002

ENTRYPOINT ["/entrypoint.sh"]
